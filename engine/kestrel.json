      "source": "OpenAPI 3.1.0 · Social API 1.0.0",
      "schemaDefs": {
        "components": {
          "schemas": {
            "AuthResponse": {
              "description": "Returned by register, login and refresh. Carries the user so no follow-up\nrequest is needed, and the access token expiry so the client can refresh\nbefore a request fails rather than after.\n",
              "properties": {
                "accessToken": {
                  "description": "Send as `Authorization: Bearer …`. Hold in memory only.",
                  "type": "string"
                },
                "accessTokenExpiresAt": {
                  "$ref": "#/components/schemas/Timestamp"
                },
                "refreshToken": {
                  "description": "Store in secure device storage, never in plain async storage. Replaced\non every refresh — persist the new one immediately.\n",
                  "type": "string"
                },
                "user": {
                  "$ref": "#/components/schemas/User"
                }
              },
              "required": [
                "accessToken",
                "refreshToken",
                "accessTokenExpiresAt",
                "user"
              ],
              "type": "object"
            },
            "CreatePostRequest": {
              "example": {
                "caption": "Sunset from the office."
              },
              "properties": {
                "caption": {
                  "maxLength": 2200,
                  "type": "string"
                },
                "imageKey": {
                  "description": "Optional key from a `purpose: \"post\"` presign. Omit or send null to\ncreate a text-only post.\n",
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UploadKey"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "type": "object"
            },
            "Error": {
              "description": "The shape of every failure. `message` is safe to show to the user;\n`code` never is.\n",
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "description": "Stable identifier to branch on. Never render this.",
                      "enum": [
                        "VALIDATION_FAILED",
                        "INVALID_CREDENTIALS",
                        "TOKEN_EXPIRED",
                        "TOKEN_INVALID",
                        "FORBIDDEN",
                        "NOT_FOUND",
                        "CONFLICT",
                        "FILE_TOO_LARGE",
                        "UNSUPPORTED_MEDIA_TYPE",
                        "RATE_LIMITED",
                        "INTERNAL_ERROR"
                      ],
                      "type": "string"
                    },
                    "details": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Field name to reason. Present on validation and conflict failures.",
                      "type": "object"
                    },
                    "message": {
                      "description": "User-facing British English. Safe to display.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            },
            "Health": {
              "description": "What both health endpoints return. More than a status word on purpose:\nduring an incident these are the fields you want without shelling into\nthe box -- which build is running, and how long it has been up. An\n`uptimeSeconds` that keeps resetting means the process is crash-looping.\n",
              "properties": {
                "environment": {
                  "examples": [
                    "production",
                    "development"
                  ],
                  "type": "string"
                },
                "goVersion": {
                  "examples": [
                    "1.26.0"
                  ],
                  "type": "string"
                },
                "revision": {
                  "description": "Short VCS revision, with `-dirty` appended when the working tree had\nuncommitted changes. Absent when not built from a repository.\n",
                  "examples": [
                    "9f2c1ab4de70"
                  ],
                  "type": "string"
                },
                "service": {
                  "description": "Identifies this service where several report to one dashboard.",
                  "examples": [
                    "domieface-server"
                  ],
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "ok",
                    "degraded"
                  ],
                  "type": "string"
                },
                "time": {
                  "$ref": "#/components/schemas/Timestamp"
                },
                "uptimeSeconds": {
                  "minimum": 0,
                  "type": "integer"
                },
                "version": {
                  "description": "The release stamped at build time, falling back to the VCS revision,\nand to `dev` for a local build.\n",
                  "examples": [
                    "1.4.0"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "service",
                "version",
                "goVersion",
                "environment",
                "time",
                "uptimeSeconds"
              ],
              "type": "object"
            },
            "HealthCheck": {
              "description": "One dependency's verdict.",
              "properties": {
                "error": {
                  "description": "Why the check failed, omitted when it passed. These endpoints are\nunauthenticated, so this says what failed, not where.\n",
                  "examples": [
                    "unreachable"
                  ],
                  "type": "string"
                },
                "latencyMs": {
                  "description": "How long the check took. Worth watching on its own: a check that\npasses in 1900ms is a dependency about to start failing.\n",
                  "minimum": 0,
                  "type": "integer"
                },
                "name": {
                  "examples": [
                    "database"
                  ],
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "ok",
                    "degraded"
                  ],
                  "type": "string"
                }
              },
