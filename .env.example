# Copy to .env (gitignored). Read by the engine (dotenvy) and by kestrel/next.config.ts.

# Postgres. For development: `docker compose up -d db` (published on 5433, so it doesn't clash with
# a Postgres installed on the host). In production, the URL of the database you provisioned.
KESTREL_DATABASE_URL=postgres://kestrel:kestrel@localhost:5433/kestrel
# Database tests (`cargo test`) use this one. Each test works in its own schemas and drops them, so
# sharing the development database is fine. Unset, those tests are skipped (CI refuses to skip).
KESTREL_TEST_DATABASE_URL=postgres://kestrel:kestrel@localhost:5433/kestrel

# Encrypts stored secrets (AES-256-GCM). 64 hex characters: `openssl rand -hex 32`. Required.
# Keep it safe and stable: losing or changing it makes every stored secret unreadable.
KESTREL_SECRETS_KEY=

# The UI sends this token on every request; the engine rejects anything without it.
# e.g. 1a597c24cc44db4f2d79d47eb91c6374cbe79f830491fe48ed75dee6225a875f
KESTREL_TOKEN=change-me-to-a-long-random-string
KESTREL_PORT=7070
KESTREL_ALLOWED_HOSTS=deploy.local
# Only used by `engine import-sqlite`, to find the old SQLite workspaces under workspaces/.
KESTREL_WORKSPACE_DIR=/folder
KESTREL_BIND=::
